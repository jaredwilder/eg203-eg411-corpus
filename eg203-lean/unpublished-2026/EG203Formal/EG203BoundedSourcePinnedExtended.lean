/-- Source-pinned coverage predicate: `q covers (k,l) iff 2^k · 3^l ≡ −1 mod q`. -/
def isCovered (q k l : Nat) : Bool :=
 ((Nat.pow 2 k * Nat.pow 3 l) % q + 1) % q == 0

